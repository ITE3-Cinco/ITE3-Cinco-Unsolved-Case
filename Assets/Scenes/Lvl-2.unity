  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8275f56278774582b7c70679d4a7a469, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Level2NoteNpc
  promptMessage: Press [E] to talk to the frightened woman
  itemData: {fileID: 0}
  isCheckpoint: 0
  checkpoint: {fileID: 0}
  isArtifact: 0
  flashlightObjective: {fileID: 0}
  artifacts: {fileID: 226000010}
  objective: {fileID: 8800000000000000100}
  notifications: {fileID: 226000011}
  nervousIdle: {fileID: 226000004}
  nextSceneName: Level3
  onCluesReturned:
    m_PersistentCalls:
      m_Calls: []
  initialDialogue: Please... I'm scared. Something terrible happened here. There
    are Notes scattered around this place. Please find ALL of them, then come back
    to me. I can't explain everything yet... Be careful out there.
  returnedDialogue: You found everything... Thank you. These clues can finally bring
    the truth to light. Please, listen. There's something I need to tell you.
  revealDialogue:
  - Renato... the coworker you met before coming here. He is the serial killer behind
    this cold case. These Notes are the evidence of what he did.
  - I was one of his victims. The woman you've seen in white... that's me. I am the
    White Lady.
  - I was trying to reach you, to warn you about Renato. I need the truth exposed.
    I need justice for all of us. Take this evidence and survive.
